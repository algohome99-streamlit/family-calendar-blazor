@using FamilyCalendar.Blazor.Models
@inject IDataService DataService

<div class="goals-section">
    <h2>🎯 目標牆</h2>

    @if (goals.Any())
    {
        <div class="goals-grid">
            @foreach (var goal in goals.OrderBy(g => g.Deadline))
            {
                <div class="goal-card @goal.GetCardClass()">
                    <div class="goal-header">
                        <div>
                            <span class="goal-title">@goal.GetMemberEmoji() @goal.GoalName</span>
                            <div class="goal-deadline">截止：@goal.Deadline.ToString("yyyy/MM/dd")</div>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-success" @onclick="() => CompleteGoal(goal)">✅</button>
                            <button class="btn btn-sm btn-warning" @onclick="() => HandleEdit(goal)">✏️</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteGoal(goal)">🗑️</button>
                        </div>
                    </div>

                    @foreach (var sub in goal.GetSubItems())
                    {
                        <div class="sub-item">
                            <div class="sub-item-header">
                                <span>@sub.Name</span>
                                <span>@sub.Percent%</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @sub.Percent%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p>目前沒有設定目標喔！</p>
    }
</div>

@code {
    [Parameter] public EventCallback<Goal> OnEdit { get; set; }

    private List<Goal> goals = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGoals();
    }

    public async Task RefreshAsync()
    {
        await LoadGoals();
        StateHasChanged();
    }

    private async Task LoadGoals()
    {
        goals = await DataService.GetGoalsAsync();
    }

    private async Task HandleEdit(Goal goal)
    {
        if (OnEdit.HasDelegate) await OnEdit.InvokeAsync(goal);
    }

    private async Task DeleteGoal(Goal goal)
    {
        await DataService.DeleteGoalAsync(goal.RowIndex);
        await LoadGoals();
    }

    private async Task CompleteGoal(Goal goal)
    {
        await DataService.CompleteGoalAsync(goal);
        await LoadGoals();
    }
}
