@page "/"
@inject IDataService DataService
@inject IJSRuntime JS

<div class="main-content">
    <!-- 頁籤 -->
    <div class="tabs">
        <button class="tab @(activeTab == "month" ? "active" : "")" @onclick="SetTabMonth">
            📆 本月行程
        </button>
        <button class="tab @(activeTab == "cards" ? "active" : "")" @onclick="SetTabCards">
            📋 行程卡片
        </button>
        <button class="tab @(activeTab == "history" ? "active" : "")" @onclick="SetTabHistory">
            📜 歷史紀錄
        </button>
    </div>

    <!-- 本月行程視圖 -->
    @if (activeTab == "month")
    {
        <MonthlyView Events="@events" OnDayClick="JumpToCards" />
    }

    <!-- 行程卡片視圖 -->
    @if (activeTab == "cards")
    {
        <h2>📅 近期行程總覽</h2>
        @if (isLoading)
        {
            <p>載入中...</p>
        }
        else if (!futureEvents.Any())
        {
            <p>目前沒有未來的行程喔！</p>
        }
        else
        {
            @foreach (var monthGroup in futureEvents.GroupBy(e => new { e.Date.Year, e.Date.Month }))
            {
                <div class="month-separator">
                    <span class="month-label">@monthGroup.First().Date.ToString("yyyy 年 M 月")</span>
                </div>
                <div class="events-grid">
                    @foreach (var evt in monthGroup)
                    {
                        <div id="@($"event-day-{evt.Date:yyyyMMdd}")">
                            <EventCard Event="@evt"
                                       OnEdit="() => StartEdit(evt)"
                                       OnRefresh="LoadEvents" />
                        </div>
                    }
                </div>
            }
        }
    }

    <!-- 歷史紀錄視圖 -->
    @if (activeTab == "history")
    {
        <HistoryView />
    }

    <!-- 目標牆 -->
    <GoalsWall @ref="goalsWallRef" OnEdit="StartEditGoal" />

    <!-- 新增/編輯行程表單 -->
    <EventForm EditingEvent="@editingEvent" OnSaved="OnEventSaved" OnCancel="CancelEdit" />

    <!-- 新增/編輯目標表單 -->
    <GoalForm EditingGoal="@editingGoal" OnSaved="OnGoalSaved" OnCancel="CancelEditGoal" />

    <!-- 積分排行榜 -->
    <PointsLeaderboard />
</div>

@code {
    private List<Event> events = new();
    private List<Event> futureEvents = new();
    private Event? editingEvent = null;
    private Goal? editingGoal = null;
    private GoalsWall? goalsWallRef;
    private string activeTab = "month";
    private bool isLoading = true;
    private string? pendingScrollAnchor;

    protected override async Task OnInitializedAsync()
    {
        await DataService.CleanupExpiredEventsAsync();
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        isLoading = true;
        try
        {
            events = await DataService.GetEventsAsync();
            futureEvents = events
                .Where(e => e.Date.Date >= DateTime.Today)
                .OrderBy(e => e.Date)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(Event evt)
    {
        editingEvent = evt;
    }

    private void CancelEdit()
    {
        editingEvent = null;
    }

    private void StartEditGoal(Goal goal)
    {
        editingGoal = goal;
    }

    private void CancelEditGoal()
    {
        editingGoal = null;
    }

    private async Task OnGoalSaved()
    {
        editingGoal = null;
        if (goalsWallRef != null) await goalsWallRef.RefreshAsync();
    }

    private void SetTabMonth() => activeTab = "month";
    private void SetTabCards() => activeTab = "cards";
    private void SetTabHistory() => activeTab = "history";

    private void JumpToCards(DateTime day)
    {
        activeTab = "cards";
        pendingScrollAnchor = $"event-day-{day:yyyyMMdd}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingScrollAnchor != null && activeTab == "cards")
        {
            var anchor = pendingScrollAnchor;
            pendingScrollAnchor = null;
            await JS.InvokeVoidAsync("scrollToElement", anchor);
        }
    }

    private async Task OnEventSaved()
    {
        editingEvent = null;
        await LoadEvents();
    }
}

<style>
    .main-content {
        padding-bottom: 2rem;
    }

    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }

@@media (max-width: 768px) {
        .events-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
